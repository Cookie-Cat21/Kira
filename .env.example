# Required: get yours free at https://console.groq.com
GROQ_API_KEY=gsk_...

# Optional: extra keys for batch test runs (rotate without editing the primary key)
GROQ_API_KEY_2=gsk_...
GROQ_API_KEY_3=gsk_...

# Optional: Neon Postgres connection string for the storefront catalog.
# When unset, the storefront serves data/seed-catalog.json automatically.
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=
